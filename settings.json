      "Edit(~/.aws/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.netrc)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.npmrc)",
      "Edit(~/.pypirc)",
      "Edit(~/.cargo/credentials.toml)",
      "Edit(~/.azure/**)",
      "Edit(~/.oci/**)",
      "Edit(~/.terraform.d/**)",
      "Edit(~/.pgpass)",
      "Edit(**/.git/hooks/**)",
      "Edit(**/.git/config)",
      "Edit(**/.git/info/exclude)",
      "Edit(**/.git/HEAD)",
      "Edit(**/.git/packed-refs)",
      "Edit(**/.githooks/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/block-cd.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/git-guard.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "language": "Japanese",
  "sandbox": {
    "enabled": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "objects.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "*.crates.io",
        "docs.rs",
        "sh.rustup.rs",
        "static.rust-lang.org"
      ]
    },
    "filesystem": {
      "denyWrite": [
        "~/.aws",
        "~/.ssh",
        "~/.gnupg",
        "~/.netrc",
        "~/.config/gh",
        "~/.config/gcloud",
        "~/.kube",
        "~/.docker",
        "~/.npmrc",
        "~/.pypirc",
        "~/.cargo/credentials.toml",
        "~/.azure",
        "~/.oci",
        "~/.terraform.d",
        "~/.pgpass",
        "**/.git/hooks/**",
        "**/.git/config",
        "**/.git/info/exclude",
        "**/.githooks/**"
      ],
      "denyRead": [
        "~/.aws/credentials",
        "~/.aws/config",
        "~/.ssh",
        "~/.gnupg",
        "~/.netrc",
        "~/.config/gh",
        "~/.config/gcloud",
        "~/.kube",
        "~/.docker/config.json",
        "~/.npmrc",
        "~/.pypirc",
        "~/.cargo/credentials.toml",
        "~/.azure",
        "~/.oci",
        "~/.terraform.d",
        "~/.pgpass",
        "~/.bash_history",
        "~/.zsh_history",
        "~/.psql_history",
        "~/.mysql_history",
        "~/.python_history",
        "~/.node_repl_history",
        "~/.lesshst",
        "/etc/shadow",
        "/etc/sudoers",
        "./.env",
        "./.env.local",
        "./.env.development",
        "./.env.develop",
        "./.env.production",
        "./.env.staging",
        "./.env.test",
        "./secrets",
        "./config/credentials.json",
        "**/*.pem",
        "**/*.key",
        "**/*.p12",
        "**/*.pfx",
        "**/*.keystore",
        "**/*.jks",
        "**/id_rsa",
        "**/id_ed25519",
        "**/id_dsa",
        "**/id_ecdsa",
        "**/serviceAccountKey*.json",
        "**/*.tfstate",
        "**/*.tfstate.backup",
        "**/terraform.tfvars"
      ],
      "allowRead": ["~/.config/gh"]
    }
  },
  "effortLevel": "medium",
  "agentPushNotifEnabled": true
}
