      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(xargs:*)",
      "Bash(jq:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(nl:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(column:*)",
      "Bash(comm:*)",
      "Bash(diff:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
