      "Bash(gh pr status:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Read(./.env.example)",
      "Read(~/.claude/rules/)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)"
