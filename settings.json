{
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.aws/credentials",
        "~/.aws/config",
        "~/.ssh",
        "~/.gnupg",
        "~/.netrc",
        "~/.config/gh",
        "~/.config/gcloud",
        "~/.kube",
        "~/.docker/config.json",
        "~/.npmrc",
        "~/.pypirc",
        "~/.cargo/credentials.toml"
      ],
      "denyWrite": [
        "~/.aws",
        "~/.ssh",
        "~/.gnupg",
        "~/.netrc",
        "~/.config/gh",
        "~/.config/gcloud",
        "~/.kube",
        "~/.docker",
        "~/.npmrc",
        "~/.pypirc",
        "~/.cargo/credentials.toml"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "objects.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "*.crates.io",
        "docs.rs",
        "sh.rustup.rs",
        "static.rust-lang.org"
      ]
    }
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(uv run pytest:*)",
      "Read(./.env.example)",
      "Bash(~/.claude/scripts/diff-budget.sh)",
      "Bash(~/.claude/scripts/diff-budget.sh *)",
      "Read(~/.claude/rules/)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git clean:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",

      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf *)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(shred:*)",
      "Bash(chmod -R 777:*)",
      "Bash(chmod 777:*)",
      "Bash(chown -R:*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(find * -exec sh*)",

      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chsh:*)",
      "Bash(passwd:*)",
      "Bash(useradd:*)",
      "Bash(userdel:*)",
      "Bash(usermod:*)",

      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(ftp:*)",
      "Bash(sftp:*)",

      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.develop)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./build)",
      "Read(./target)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.cargo/credentials.toml)",

      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.develop)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(./config/credentials.json)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/id_rsa)",
      "Edit(**/id_ed25519)",
      "Edit(~/.aws/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.netrc)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.npmrc)",
      "Edit(~/.pypirc)",
      "Edit(~/.cargo/credentials.toml)"
    ]
  },
  "language": "Japanese",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -Command \"[console]::beep(1760,200); Start-Sleep -Milliseconds 80; [console]::beep(1760,200)\"",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  }
}
