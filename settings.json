      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.develop)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(./config/credentials.json)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
