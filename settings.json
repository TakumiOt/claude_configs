      "Bash(git filter-branch:*)",
      "Bash(git submodule:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf *)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(shred:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(chgrp:*)",
      "Bash(setfacl:*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(find * -exec sh*)",
      "Bash(find * -exec chmod*)",
      "Bash(find * -exec chown*)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chsh:*)",
      "Bash(passwd:*)",
      "Bash(useradd:*)",
      "Bash(userdel:*)",
      "Bash(usermod:*)",
      "Bash(gpasswd:*)",
      "Bash(groupadd:*)",
      "Bash(groupdel:*)",
      "Bash(groupmod:*)",
      "Bash(adduser:*)",
      "Bash(addgroup:*)",
      "Bash(deluser:*)",
      "Bash(delgroup:*)",
      "Bash(newgrp:*)",
      "Bash(sg:*)",
      "Bash(visudo:*)",
      "Bash(setcap:*)",
      "Bash(newuidmap:*)",
      "Bash(newgidmap:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(ftp:*)",
      "Bash(sftp:*)",
      "Bash(sqlx:*)",
      "Bash(git config:*)",
      "Bash(git update-ref:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git hook:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.develop)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./build)",
