      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/serviceAccountKey*.json)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/terraform.tfvars)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
